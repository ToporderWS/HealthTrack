# 《康迹 HealthTrack》后端环境变量模板
# 依据：《S1-D-开发环境与工程实施准备》§4.2「环境变量清单（.env.example 内容冻结）」
#
# ⚠️ 本文件为**模板**，全部为占位符，**可以提交到 Git**。
# ⚠️ 真实密钥请写入 backend/.env.development 或 backend/.env（**已被 .gitignore 排除**）。
# ⚠️ 任何真实密码 / JWT 密钥 / API Key **不得**写入代码、文档、注释、日志或测试用例。

# ── 运行环境 ─────────────────────────────────────────────
APP_ENV=development                 # development | test | production

# ── 安全密钥（真实值只写 .env；.env.example 仅占位）──────
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_HEX      # JWT 签名密钥
BCRYPT_ROUNDS=12                            # 密码哈希 cost
# 找回密码验证码 HMAC pepper（CR-F006-001 · B1）
# ⚠️ 必须**独立于 SECRET_KEY**（用途分离 / 可独立轮换）；生产环境缺失即启动失败；
# ⚠️ 真值只写 backend/.env（gitignore），**不得**写入代码 / 文档 / 日志 / 报告。
PASSWORD_RESET_PEPPER=CHANGE_ME_TO_RANDOM_64_HEX

# ── Token 有效期（承接 S1-A / S1-B，不得随意改）──────────
TOKEN_ACCESS_MINUTES=120                    # Access Token 2 小时
TOKEN_REFRESH_DAYS=30                       # Refresh Token 30 天

# ── 登录失败锁定（承接 S1-A，不得随意改）────────────────
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=5
LOGIN_LOCK_STEP_1_MINUTES=15
LOGIN_LOCK_STEP_2_MINUTES=60

# ── 会话内验密上限（承接 S1-A）──────────────────────────
VERIFY_MAX_PASSWORD_CHANGE=5               # 改密 5 次
VERIFY_MAX_EXPORT=3                         # 导出 3 次

# ── 数据库 ──────────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DB=kangji_healthtrack
MYSQL_CHARSET=utf8mb4

# ── 导出临时文件（承接 S1-B）───────────────────────────
EXPORT_DIR=./storage/exports
EXPORT_DOWNLOAD_TTL_MINUTES=10              # 下载令牌 10 分钟
EXPORT_PURGE_MINUTES=60                     # 文件 60 分钟强制清理

# ── 找回密码邮件投递（CR-F006-001 · B2；MAIL-DELIVERY-1 起 smtp 为真实投递）──
# 可选值：memory（缺省；进程内，测试/开发零副作用）| file-outbox | redacted-console
#         | smtp（**真实投递**：标准库 smtplib，凭据只从运行时环境读取）
MAIL_BACKEND=memory
# MAIL_OUTBOX_DIR=./storage/mail_outbox     # 仅 MAIL_BACKEND=file-outbox 时使用（缺省不创建该目录）
#
# ── SMTP 配置（**仅 MAIL_BACKEND=smtp 时使用**；MAIL-DELIVERY-1）──
# ⚠️ 以下**全部为占位说明**，仓库中**绝不允许**出现任何真实口令 / 真实账号。
#    真实值只写本机 `backend/.env`（已被 .gitignore 排除）。
#    缺 / 非法 ⇒ 该次投递 fail-closed（收敛为「未投递」，不影响对外响应）。
# 后端取值（缺省 smtp.gmail.com / 587 / TLS=true / timeout=10）
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true                         # 显式布尔（true/false/1/0/yes/no/on/off）
# SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME     # 发信账号（如 Gmail 地址）
# SMTP_PASSWORD=CHANGE_ME_SMTP_APP_PASSWORD # 应用专用密码（**只写 .env，勿提交**）
# SMTP_FROM=                                # 留空 ⇒ 回落 SMTP_USERNAME
# SMTP_TIMEOUT=10
# ── 头像（S4-2）─────────────────────────────────────────
AVATAR_DIR=./storage/avatars                # 头像文件目录（与 exports 同级；**不挂静态目录，读取必须鉴权**）
AVATAR_MAX_BYTES=2097152                    # 2 MiB = 2 * 1024 * 1024


# ── 日志（I-05 保留期待法律审核，先按 180 天可配）────────
LOG_DIR=./logs
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=180                      # 待 I-05 定稿后再确认

# ── 软删清理 ────────────────────────────────────────────
SOFT_DELETE_PURGE_DAYS=30                   # 仅 3 张记录型表适用
